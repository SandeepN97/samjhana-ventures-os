# =============================================================================
# Samjhana Ventures OS — Environment Variables
# =============================================================================
# Copy this file to .env for local overrides (never commit .env).
# All REQUIRED variables must be set before running in production.
# =============================================================================

# --- JWT Authentication (REQUIRED in production) ---
# Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters

# --- Initial Admin Password (optional, production only) ---
# If unset on first boot, a random password is generated and printed once to logs.
# ADMIN_INITIAL_PASSWORD=your-secure-initial-password

# --- Database (development default: embedded H2 with empty password) ---
# DB_PASSWORD=        # H2 embedded — leave blank for local dev

# --- Database (production — all three REQUIRED when using PostgreSQL) ---
# DATABASE_URL=jdbc:postgresql://host:5432/samjhana_db
# DATABASE_USERNAME=samjhana_user
# DATABASE_PASSWORD=change-me

# --- OCPP charger secrets (REQUIRED in production) ---
# One secret per charger: it is the charger's OCPP Basic-auth password. The app refuses to
# start in prod with missing or "dev-" secrets. Generate each with: openssl rand -base64 32
# OCPP_SECRET_HD_D180_CC_01=
# OCPP_SECRET_HQC23_80_01=
# OCPP_SECRET_HD_D140_E_01=
# EXPLICIT_UNLOCK (default) or AUTO_UNLOCK_ON_STOP — see docs/EV-CHARGING-ARCHITECTURE.md
# OCPP_LOCK_BEHAVIOR=EXPLICIT_UNLOCK

# --- CORS (production) ---
# Set to your Vercel/frontend URL. Comma-separated for multiple origins.
# SAMJHANA_CORS_ALLOWED_ORIGINS=https://your-app.vercel.app

# --- Server Port ---
# PORT=8080